# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PERSISTENCE CONFIGURATION
# PERSISTENCE_TYPE: 'json' (default for prototype), 'firestore' (Firebase Firestore), or 'postgres'
PERSISTENCE_TYPE="json"

# FIREBASE CLIENT CONFIGURATION (Frontend / Browser - Vite Variables)
# Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# FIREBASE ADMIN SDK CONFIGURATION (Server-Side / Vercel Serverless)
# Option A (Recommended for Vercel): Individual environment variables
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Full JSON Service Account string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id",...}'

# REQUIRE_AUTH: Enforce mandatory token verification for submissions ('true' | 'false').
# Defaults to false in local development so prototype runs without credentials.
# Automatically treated as required when PERSISTENCE_TYPE=firestore.
REQUIRE_AUTH="false"

# DATABASE_URL: Managed PostgreSQL connection string.
# NOTE: DATABASE_URL is OPTIONAL when PERSISTENCE_TYPE=json (the prototype default).
# It is ONLY required when PERSISTENCE_TYPE=postgres.
# Example: postgresql://civicpulse_admin:secret@pg-cluster.internal:5432/civicpulse_db
# DATABASE_URL=""

# OPERATIONAL & TRAFFIC GUARDS
# RATE_LIMIT_ENABLED: Enforce in-memory sliding-window abuse guards ('true' | 'false'). Default: false
RATE_LIMIT_ENABLED="false"

# NODE_ENV: Runtime execution profile ('development' | 'production')
NODE_ENV="development"


